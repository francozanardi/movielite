FROM python:3.11-slim-bookworm

# Pinned via base image (bookworm). Byte-exact output requires that everyone
# building this image ends up with the same ffmpeg build — bookworm's apt repo
# ships a single stable version per point release, which is enough for that.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libgl1 \
        libglib2.0-0 \
        libfontconfig1 \
        libegl1 \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Prime dependency install so subsequent `docker run` doesn't re-install on
# every source edit. The bind-mount at run time will shadow /workspace/src,
# but installed deps live in site-packages and survive.
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir -e ".[test]"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

CMD ["pytest", "tests/e2e", "-v"]
